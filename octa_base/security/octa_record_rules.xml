<?xml version="1.0" encoding="utf-8"?>
<odoo>

<data noupdate="1">

    <!-- ════════════════════════════════════════════════════════════
         AUDIT LOG — SCOPE FILTER

         TDABG và Lead: chỉ thấy audit log có scope_tag='bigtel'
         hoặc chưa gán scope (hệ thống / technical log).

         PPKD/TPKD: thấy toàn bộ log Phòng KD.
         → Không cần rule riêng cho PPKD/TPKD
           (Odoo default: không có rule → thấy tất cả trong phạm vi ACL).

         Lưu ý: group_tdabg implied group_lead
         → Rule này apply cho cả Lead vì Lead là subset của TDABG
           NHƯNG Odoo apply rule của group thấp nhất user thuộc về.
         → Cần 2 rule riêng biệt cho TDABG và Lead.
    ════════════════════════════════════════════════════════════════ -->

    <record id="rule_audit_log_lead_scope" model="ir.rule">
        <field name="name">Octa: Lead chỉ thấy audit log Bigtel</field>
        <field name="model_id" ref="model_octa_audit_log"/>
        <field name="groups" eval="[(4, ref('octa_base.group_lead'))]"/>
        <field name="domain_force">
            ['|',
                ('scope_tag', '=', 'bigtel'),
                ('scope_tag', '=', False)
            ]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_audit_log_tdabg_scope" model="ir.rule">
        <field name="name">Octa: TDABG chỉ thấy audit log Bigtel</field>
        <field name="model_id" ref="model_octa_audit_log"/>
        <field name="groups" eval="[(4, ref('octa_base.group_tdabg'))]"/>
        <field name="domain_force">
            ['|',
                ('scope_tag', '=', 'bigtel'),
                ('scope_tag', '=', False)
            ]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        PPKD: thấy Bigtel full + TC_TM + AUTHORIZED scope.
        Không thấy log BigM/UTV trực tiếp (chỉ xem qua dashboard tổng hợp).
    -->
    <record id="rule_audit_log_ppkd_scope" model="ir.rule">
        <field name="name">Octa: PPKD thấy log Bigtel + TC_TM + Authorized</field>
        <field name="model_id" ref="model_octa_audit_log"/>
        <field name="groups" eval="[(4, ref('octa_base.group_ppkd'))]"/>
        <field name="domain_force">
            ['|', '|', '|',
                ('scope_tag', '=', 'bigtel'),
                ('scope_tag', '=', 'tc_tm'),
                ('scope_tag', '=', 'authorized'),
                ('scope_tag', '=', False)
            ]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        TPKD: thấy toàn bộ log Phòng KD (tất cả scope).
        Không cần rule riêng — Odoo default không có rule → thấy tất cả.
        Nhưng để explicit và dễ audit, vẫn khai báo rule open.
    -->
    <record id="rule_audit_log_tpkd_scope" model="ir.rule">
        <field name="name">Octa: TPKD thấy toàn bộ audit log</field>
        <field name="model_id" ref="model_octa_audit_log"/>
        <field name="groups" eval="[(4, ref('octa_base.group_tpkd'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</data>
</odoo>