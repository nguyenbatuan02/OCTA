<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view — readonly toàn bộ -->
    <record id="view_octa_audit_log_list" model="ir.ui.view">
        <field name="name">octa.audit.log.list</field>
        <field name="model">octa.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="0" edit="0" delete="0"
                  decoration-danger="emergency == True"
                  decoration-warning="escalation_level in ['L3','L4','L5']">
                <field name="log_time" string="Thời điểm"/>
                <field name="user_name" string="Người thực hiện"/>
                <field name="action_type" string="Hành động"/>
                <field name="object_model" string="Model"/>
                <field name="object_name" string="Đối tượng"/>
                <field name="scope_tag" string="Scope"/>
                <field name="escalation_level" string="Tầng"/>
                <field name="emergency" string="Khẩn" widget="boolean"/>
                <field name="reason" string="Lý do" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form view — readonly toàn bộ -->
    <record id="view_octa_audit_log_form" model="ir.ui.view">
        <field name="name">octa.audit.log.form</field>
        <field name="model">octa.audit.log</field>
        <field name="arch" type="xml">
            <form string="Chi tiết Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Thông tin cơ bản">
                            <field name="log_time" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="user_name" readonly="1"/>
                            <field name="action_type" readonly="1"/>
                        </group>
                        <group string="Phân loại">
                            <field name="scope_tag" readonly="1"/>
                            <field name="escalation_level" readonly="1"/>
                            <field name="emergency" readonly="1"/>
                            <field name="authorization_doc_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Đối tượng">
                        <field name="object_model" readonly="1"/>
                        <field name="object_id" readonly="1"/>
                        <field name="object_name" readonly="1"/>
                        <field name="approval_state" readonly="1"/>
                    </group>
                    <group string="Nội dung thay đổi">
                        <field name="old_value" readonly="1"/>
                        <field name="new_value" readonly="1"/>
                        <field name="reason" readonly="1"/>
                        <field name="attachment_ref" readonly="1"/>
                    </group>
                    <group string="Kỹ thuật" groups="base.group_system">
                        <field name="ip_address" readonly="1"/>
                        <field name="session_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_octa_audit_log_search" model="ir.ui.view">
        <field name="name">octa.audit.log.search</field>
        <field name="model">octa.audit.log</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Audit Log">
                <field name="user_name" string="Người thực hiện"/>
                <field name="object_name" string="Đối tượng"/>
                <field name="reason" string="Lý do"/>
                <separator/>
                <filter name="emergency" string="Lệnh khẩn cấp"
                        domain="[('emergency', '=', True)]"/>
                <filter name="escalate" string="Có leo thang"
                        domain="[('action_type', '=', 'escalate')]"/>
                <filter name="today" string="Hôm nay"
                        domain="[('log_time', '>=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_action" string="Hành động"
                            context="{'group_by': 'action_type'}"/>
                    <filter name="group_scope" string="Scope"
                            context="{'group_by': 'scope_tag'}"/>
                    <filter name="group_user" string="Người thực hiện"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Ngày"
                            context="{'group_by': 'log_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_octa_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">octa.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
