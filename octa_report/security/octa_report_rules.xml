<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

  <!-- NV chỉ thấy báo cáo của mình -->
  <record id="rule_report_own" model="ir.rule">
    <field name="name">Báo cáo: nhân viên chỉ thấy của mình</field>
    <field name="model_id" ref="model_octa_report"/>
    <field name="domain_force">[('author_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('octa_base.group_octa_cskh')), (4, ref('octa_base.group_octa_ops'))]"/>
  </record>

  <!-- Lead trở lên thấy toàn bộ (để duyệt) -->
  <record id="rule_report_lead_all" model="ir.rule">
    <field name="name">Báo cáo: Lead trở lên thấy tất cả</field>
    <field name="model_id" ref="model_octa_report"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('octa_base.group_lead'))]"/>
  </record>

</data>
</odoo>
