<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ FORM ══ -->
    <record id="view_octa_gateway_form" model="ir.ui.view">
        <field name="name">octa.gateway.form</field>
        <field name="model">octa.gateway</field>
        <field name="arch" type="xml">
            <form string="Cổng API">
                <header>
                    <button name="action_open_command_wizard"
                            string="⚡ Ra lệnh mở/đóng"
                            type="object"
                            class="btn-primary"
                            groups="octa_base.group_lead"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,warning,closed,locked"/>
                </header>
                <sheet>
                    <!-- Banner cổng bị khóa -->
                    <div class="alert alert-danger mb-3"
                         invisible="state != 'locked'">
                        🔴 <strong>CỔNG ĐANG BỊ KHÓA TỰ ĐỘNG (Ranh đỏ)</strong><br/>
                        Thời điểm khóa: <field name="auto_locked_at" readonly="1" nolabel="1"/>
                        — Hạn bổ sung phê duyệt: <field name="emergency_deadline" readonly="1" nolabel="1"/>
                    </div>
                    <!-- Banner cảnh báo số dư -->
                    <div class="alert alert-warning mb-3"
                         invisible="not is_balance_low">
                        🟡 <strong>SỐ DƯ API THẤP</strong> —
                        <field name="api_balance" readonly="1" nolabel="1"
                               widget="monetary" options="{'currency_field': false}"/> VNĐ
                        ≤ ngưỡng <field name="api_balance_threshold" readonly="1" nolabel="1"
                                       widget="monetary" options="{'currency_field': false}"/> VNĐ
                    </div>

                    <field name="is_balance_low" invisible="1"/>

                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="code" placeholder="Mã kỹ thuật VD: GW-VT-39"/></h3>
                    </div>

                    <group>
                        <group string="Thông tin cổng">
                            <field name="gateway_type"/>
                            <field name="scope"/>
                            <field name="network"/>
                            <field name="ncc_id"/>
                            <field name="is_backup"/>
                            <field name="backup_gateway_id"
                                   invisible="is_backup"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Vận hành">
                            <field name="api_balance"
                                   widget="monetary"
                                   options="{'currency_field': false}"/>
                            <field name="api_balance_threshold"
                                   widget="monetary"
                                   options="{'currency_field': false}"/>
                            <field name="success_rate"/>
                            <field name="error_count"/>
                            <field name="last_error_time"/>
                        </group>
                    </group>

                    <!-- Nút xem lịch sử lệnh -->
                    <div>
                        <button name="action_view_commands"
                                type="object"
                                string="Xem lịch sử lệnh"
                                class="btn-secondary"
                                icon="fa-history"/>
                        <field name="command_count" nolabel="1" readonly="1"/>
                        lệnh
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ══ LIST ══ -->
    <record id="view_octa_gateway_list" model="ir.ui.view">
        <field name="name">octa.gateway.list</field>
        <field name="model">octa.gateway</field>
        <field name="arch" type="xml">
            <tree string="Cổng API"
                  decoration-danger="state == 'locked'"
                  decoration-warning="state == 'warning'"
                  decoration-muted="state == 'closed'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="gateway_type"/>
                <field name="network"/>
                <field name="ncc_id"/>
                <field name="state"/>
                <field name="error_count"/>
                <field name="api_balance"
                       widget="monetary"
                       options="{'currency_field': false}"/>
                <field name="success_rate" string="Success %"/>
                <field name="emergency_deadline"/>
                <button name="action_open_command_wizard"
                        type="object"
                        string="Lệnh"
                        icon="fa-bolt"
                        groups="octa_base.group_lead"/>
            </tree>
        </field>
    </record>

    <!-- ══ ACTION ══ -->
    <record id="action_octa_gateway" model="ir.actions.act_window">
        <field name="name">Cổng API</field>
        <field name="res_model">octa.gateway</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có cổng API nào được cấu hình
            </p>
            <p>Tạo cổng mới để bắt đầu theo dõi và quản lý.</p>
        </field>
    </record>

    <record id="action_octa_gateway_locked" model="ir.actions.act_window">
        <field name="name">Cổng đang khóa</field>
        <field name="res_model">octa.gateway</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'locked')]</field>
    </record>

</odoo>