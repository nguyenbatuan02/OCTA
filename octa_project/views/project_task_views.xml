<?xml version="1.0" encoding="utf-8"?>
<odoo>
   
    <record id="view_task_form_octa_project" model="ir.ui.view">
        <field name="name">project.task.form.octa.project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">5</field>
        <field name="arch" type="xml">

            <!-- Đổi label user_ids -->
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="string">Người thực hiện</attribute>
            </xpath>

            <!-- Thêm supervisor + related sau user_ids -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="supervisor_ids"
                       widget="many2many_tags"
                       string="Người giám sát"/>
                <field name="related_user_ids"
                       widget="many2many_tags"
                       string="Người liên quan"/>
            </xpath>

            <!-- date_closed readonly ở cuối -->
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="date_closed"
                       string="Thời điểm đóng"
                       readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>