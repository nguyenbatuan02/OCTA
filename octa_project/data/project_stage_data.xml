<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
<!--
    Thứ tự stage theo luồng ticket Octa:
    Mới → Đang xử lý → Chờ phối hợp → Chờ duyệt → Đã đóng
-->

    <record id="stage_octa_new" model="project.task.type">
        <field name="name">Mới</field>
        <field name="sequence">10</field>
        <field name="fold">False</field>
        <field name="description">
            Ticket vừa tạo, chưa có người xử lý.
            NV CSKH/VH cần nhận và bắt đầu xử lý trong thời gian SLA.
        </field>
    </record>

    <record id="stage_octa_in_progress" model="project.task.type">
        <field name="name">Đang xử lý</field>
        <field name="sequence">20</field>
        <field name="fold">False</field>
        <field name="description">
            Ticket đang được xử lý. Người thực hiện đã nhận và đang theo dõi.
        </field>
    </record>

    <record id="stage_octa_waiting" model="project.task.type">
        <field name="name">Chờ phối hợp</field>
        <field name="sequence">30</field>
        <field name="fold">False</field>
        <field name="description">
            Đang chờ bộ phận khác xử lý ticket liên kết.
            Không đóng ticket này cho đến khi ticket liên kết hoàn thành.
        </field>
    </record>

    <record id="stage_octa_pending_approval" model="project.task.type">
        <field name="name">Chờ duyệt</field>
        <field name="sequence">40</field>
        <field name="fold">False</field>
        <field name="description">
            Ticket cần phê duyệt (hoàn tiền/nạp bù vượt hạn mức).
            Đang chờ Lead/TDABG/PPKD/TPKD phê duyệt.
        </field>
    </record>

    <record id="stage_octa_done" model="project.task.type">
        <field name="name">Đã đóng</field>
        <field name="sequence">100</field>
        <field name="fold">True</field>
        <field name="description">
            Ticket đã có kết quả cuối rõ ràng và được đóng.
            date_closed tự động ghi khi vào stage này.
        </field>
    </record>

</data>
</odoo>