<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

  <!-- Nhóm phụ trách -->
  <record id="team_cskh" model="octa.vd6.team">
    <field name="code">CSKH</field><field name="name">Chăm sóc khách hàng</field>
  </record>
