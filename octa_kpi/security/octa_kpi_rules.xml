<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

  <!-- KPI: NV chỉ thấy KPI của chính mình -->
  <record id="rule_kpi_own" model="ir.rule">
    <field name="name">KPI: nhân viên chỉ thấy của mình</field>
    <field name="model_id" ref="model_octa_kpi"/>
    <field name="domain_force">[('user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('octa_base.group_octa_cskh')), (4, ref('octa_base.group_octa_ops'))]"/>
  </record>

  <!-- KPI: Lead trở lên thấy toàn bộ -->
  <record id="rule_kpi_lead_all" model="ir.rule">
    <field name="name">KPI: Lead trở lên thấy tất cả</field>
    <field name="model_id" ref="model_octa_kpi"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('octa_base.group_lead'))]"/>
  </record>

</data>
</odoo>
