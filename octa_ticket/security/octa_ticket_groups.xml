<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="base.module_category_octa_ticket" model="ir.module.category">
      <field name="name">Octa Ticket</field>
      <field name="sequence">100</field>
      <field name="visible">True</field>
    </record>

    <record id="group_octa_cskh" model="res.groups">
      <field name="name">CSKH</field>
      <field name="category_id" ref="base.module_category_octa_ticket"/>
      <field name="comment">Cham soc khach hang - chi xem ticket dept=cskh</field>
    </record>

    <record id="group_octa_ops" model="res.groups">
      <field name="name">Van hanh</field>
      <field name="category_id" ref="base.module_category_octa_ticket"/>
      <field name="comment">Van hanh thuong mai - chi xem ticket dept=ops</field>
    </record>

    <record id="group_octa_manager" model="res.groups">
      <field name="name">Quan ly / Admin</field>
      <field name="category_id" ref="base.module_category_octa_ticket"/>
      <field name="comment">Xem toan bo ticket moi bo phan</field>
      <field name="implied_ids" eval="[(4, ref('group_octa_cskh')), (4, ref('group_octa_ops'))]"/>
    </record>

  </data>
</odoo>