<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══ EXTEND FORM res.partner ══ -->
    <record id="view_res_partner_form_octa" model="ir.ui.view">
        <field name="name">res.partner.form.octa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Thêm tab Octa vào notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Octa" name="octa_info"
                      invisible="not octa_partner_type">
                    <!-- Banner ranh đỏ công nợ -->
                    <div class="alert alert-danger mb-3"
                         invisible="not is_debt_overlimit">
                        🔴 <strong>VƯỢT HẠN MỨC CÔNG NỢ!</strong>
                        Công nợ hiện tại
                        <field name="current_debt" nolabel="1" readonly="1"
                               />
                        vượt hạn mức
                        <field name="debt_limit" nolabel="1" readonly="1"
                               />
                        (<field name="debt_usage_pct" nolabel="1" readonly="1"/>%)
                    </div>
                    <!-- Banner ranh đỏ tập trung -->
                    <div class="alert alert-danger mb-3"
                         invisible="not is_concentration_warning">
                        🔴 <strong>RANH ĐỎ TẬP TRUNG!</strong>
                        <field name="red_line_note" nolabel="1" readonly="1"/>
                    </div>
                    <!-- Banner HĐ sắp hết hạn -->
                    <div class="alert alert-warning mb-3"
                         invisible="not is_contract_expiring">
                        🟡 <strong>HỢP ĐỒNG SẮP HẾT HẠN!</strong>
                        Kết thúc ngày <field name="contract_end" nolabel="1" readonly="1"/>
                    </div>
                    <field name="is_debt_overlimit"       invisible="1"/>
                    <field name="is_concentration_warning" invisible="1"/>
                    <field name="is_contract_expiring"    invisible="1"/>
                    <group>
                        <group string="Phân loại Octa">
                            <field name="octa_partner_type"/>
                            <field name="scope"/>
                            <field name="agent_grade"
                                   invisible="octa_partner_type == 'ncc'"/>
                            <field name="agent_grade_updated"
                                   invisible="not agent_grade"
                                   readonly="1"/>
                        </group>
                        <group string="Hợp đồng">
                            <field name="contract_ref"/>
                            <field name="contract_start"/>
                            <field name="contract_end"/>
                        </group>
                    </group>
                    <group string="Hạn mức công nợ">
                        <group>
                            <field name="debt_limit"
                                   />
                            <field name="current_debt"
                                   readonly="1"/>
                            <field name="debt_usage_pct"
                                   string="Tỷ lệ sử dụng (%)"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="debt_limit_approved_by" readonly="1"/>
                            <field name="debt_limit_approved_at" readonly="1"/>
                        </group>
                    </group>
                    <!-- Thông tin NCC -->
                    <group string="Chỉ số NCC"
                           invisible="octa_partner_type not in ['ncc', 'both']">
                        <group>
                            <field name="ncc_sla_hours"
                                   string="SLA xử lý lỗi (giờ)"/>
                            <field name="ncc_success_rate"
                                   string="Tỷ lệ thành công (%)"/>
                            <field name="ncc_pending_rate"
                                   string="Tỷ lệ pending (%)"/>
                            <field name="ncc_error_rate"
                                   string="Tỷ lệ lỗi (%)"/>
                        </group>
                        <group>
                            <field name="ncc_concentration_pct"
                                   string="Tỷ trọng sản lượng (%)"/>
                            <field name="ncc_last_evaluated"
                                   string="Ngày đánh giá gần nhất"/>
                        </group>
                        <field name="ncc_note"
                               string="Ghi chú đánh giá"
                               placeholder="Điều kiện thương mại, lịch sử sự cố..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!-- ══ LIST VIEW NCC ══ -->
    <record id="view_res_partner_ncc_list" model="ir.ui.view">
        <field name="name">res.partner.ncc.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Nhà cung cấp (NCC)"
                  decoration-danger="is_debt_overlimit or is_concentration_warning"
                  decoration-warning="is_contract_expiring">
                <field name="is_contract_expiring" invisible="1"/>  
                <field name="name"/>
                <field name="scope"/>
                <field name="ncc_success_rate"    string="Success %"/>
                <field name="ncc_concentration_pct" string="Tỷ trọng %"/>
                <field name="debt_limit"          
                       />
                <field name="current_debt"        
                        readonly="1"/>
                <field name="debt_usage_pct"      string="% dùng"/>
                <field name="is_debt_overlimit"   widget="boolean" string="Vượt HM"/>
                <field name="is_concentration_warning" widget="boolean" string="Tập trung"/>
                <field name="contract_end"        string="Hết hạn HĐ"/>
                <field name="ncc_last_evaluated"  string="Đánh giá lần cuối"/>
            </tree>
        </field>
    </record>
    <!-- ══ LIST VIEW ĐẠI LÝ ══ -->
    <record id="view_res_partner_agent_list" model="ir.ui.view">
        <field name="name">res.partner.agent.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Đại lý"
                  decoration-danger="is_debt_overlimit or is_concentration_warning"
                  decoration-warning="is_contract_expiring">
                <field name="is_contract_expiring" invisible="1"/>  
                <field name="name"/>
                <field name="scope"/>
                <field name="agent_grade"/>
                <field name="debt_limit"     
                       />
                <field name="current_debt"   
                        readonly="1"/>
                <field name="debt_usage_pct" string="% dùng"/>
                <field name="is_debt_overlimit"        widget="boolean" string="Vượt HM"/>
                <field name="is_concentration_warning" widget="boolean" string="Tập trung"/>
                <field name="contract_end"   string="Hết hạn HĐ"/>
            </tree>
        </field>
    </record>
    <!-- ══ ACTIONS ══ -->
    <record id="action_octa_ncc" model="ir.actions.act_window">
        <field name="name">Nhà cung cấp (NCC)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('octa_partner_type', 'in', ['ncc', 'both'])]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_res_partner_ncc_list')}),
            (0, 0, {'view_mode': 'form'}),
        ]"/>
        <field name="context">{'default_octa_partner_type': 'ncc'}</field>
    </record>
    <record id="action_octa_agent" model="ir.actions.act_window">
        <field name="name">Đại lý</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('octa_partner_type', 'in', ['agent', 'both'])]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_res_partner_agent_list')}),
            (0, 0, {'view_mode': 'form'}),
        ]"/>
        <field name="context">{'default_octa_partner_type': 'agent'}</field>
    </record>
    <record id="action_octa_partner_red_line" model="ir.actions.act_window">
        <field name="name">🔴 Đối tác có ranh đỏ</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">
            ['|',
                ('is_debt_overlimit', '=', True),
                ('is_concentration_warning', '=', True)
            ]
        </field>
    </record>
</odoo>