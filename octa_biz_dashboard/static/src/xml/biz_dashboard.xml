<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="octa_biz_dashboard.Main">
    <div class="o_action" style="background:#f5f5f5; min-height:100vh;">

      <t t-if="state.loading">
        <div style="padding:60px; text-align:center; color:#888;">Đang tải...</div>
      </t>

      <t t-else="">
        <div style="display:flex; min-height:100vh;">

          <!-- ══ Sidebar: danh sách dashboard theo vị trí ══ -->
          <div style="width:250px; background:#1f2937; color:#e5e7eb; padding:16px 0; flex-shrink:0;">
            <div style="padding:0 16px 12px; border-bottom:1px solid #374151; margin-bottom:8px;">
              <div style="font-size:15px; font-weight:700;">Điều hành Octa</div>
              <div style="font-size:11px; color:#9ca3af;"><t t-esc="state.d.scope_label"/></div>
            </div>
            <t t-foreach="state.d.menu" t-as="m" t-key="m_index">
              <div t-att-style="'padding:9px 16px; cursor:pointer; font-size:13px; display:flex; justify-content:space-between; align-items:center; border-left:3px solid ' + (state.active === m.key ? '#60a5fa' : 'transparent') + '; background:' + (state.active === m.key ? '#374151' : 'transparent')"
                   t-on-click="() => this.select(m.key)">
                <span>
                  <span t-if="m.code" style="color:#9ca3af; font-size:11px;"><t t-esc="m.code"/> </span>
                  <t t-esc="m.name"/>
                </span>
                <span t-if="!m.available" style="font-size:10px; color:#f59e0b;" title="Chưa có dữ liệu nguồn">●</span>
              </div>
            </t>
          </div>

          <!-- ══ Content: dashboard đang chọn ══ -->
          <div style="flex:1; padding:20px; overflow:auto;">
            <div style="display:flex; justify-content:flex-end; margin-bottom:12px;">
              <button class="btn btn-sm btn-secondary" t-on-click="() => this.reload()">↻ Làm mới</button>
            </div>

            <!-- ── Vận hành tổng quan (DB-*-01) ── -->
            <t t-if="state.active === 'ops'">
              <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px;">
                <div style="background:#fff; border:1px solid #ddd; border-top:3px solid #4c9aff; border-radius:8px; padding:16px;">
                  <div style="color:#888; font-size:12px;">Ticket mới hôm nay</div>
                  <div style="font-size:28px; font-weight:bold;" t-esc="state.d.ops.new_today"/>
                </div>
                <div style="background:#fff; border:1px solid #ddd; border-top:3px solid #63b3ed; border-radius:8px; padding:16px;">
                  <div style="color:#888; font-size:12px;">Đang mở</div>
                  <div style="font-size:28px; font-weight:bold;" t-esc="state.d.ops.open"/>
                </div>
                <div style="background:#fff; border:1px solid #ddd; border-top:3px solid #f56565; border-radius:8px; padding:16px;">
                  <div style="color:#888; font-size:12px;">Pending quá hạn</div>
                  <div style="font-size:28px; font-weight:bold; color:#e53e3e;" t-esc="state.d.ops.pending_overdue"/>
                </div>
                <div style="background:#fff; border:1px solid #ddd; border-top:3px solid #ffab00; border-radius:8px; padding:16px;">
                  <div style="color:#888; font-size:12px;">Chờ nhận bàn giao</div>
                  <div style="font-size:28px; font-weight:bold;" t-esc="state.d.ops.handover_pending"/>
                </div>
                <div style="background:#fff; border:1px solid #ddd; border-top:3px solid #c026d3; border-radius:8px; padding:16px; cursor:pointer" t-on-click="() => this.openGateways()">
                  <div style="color:#888; font-size:12px;">Cổng bị khóa</div>
                  <div style="font-size:28px; font-weight:bold; color:#c026d3;" t-esc="state.d.ops.gate_locked"/>
                </div>
                <div style="background:#fff; border:1px solid #ddd; border-top:3px solid #f6ad55; border-radius:8px; padding:16px; cursor:pointer" t-on-click="() => this.openGateways()">
                  <div style="color:#888; font-size:12px;">Cổng cảnh báo/đóng</div>
                  <div style="font-size:28px; font-weight:bold;" t-esc="state.d.ops.gate_error"/>
                </div>
              </div>
              <div style="margin-top:14px; padding:12px; background:#fff7e6; border:1px solid #ffe0a3; border-radius:8px; font-size:12px; color:#8a6d3b;">
                ⚠ Doanh thu / sản lượng chưa hiển thị — cần model doanh thu (DB-*-01 phần DT/SL).
              </div>
            </t>

            <!-- ── Ranh đỏ (DB-*-02) ── -->
            <t t-if="state.active === 'red'">
              <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:16px;">
                <div style="font-weight:600; margin-bottom:10px;">🚨 Ranh đỏ (<t t-esc="state.d.red_lines.count"/>)</div>
                <t t-if="state.d.red_lines.count === 0">
                  <div style="color:#36b37e; font-size:13px;">✓ Không có ranh đỏ đang kích hoạt</div>
                </t>
                <t t-foreach="state.d.red_lines.items" t-as="r" t-key="r_index">
                  <div style="display:flex; gap:8px; align-items:center; padding:8px 0; border-bottom:1px solid #f4f4f4;">
                    <span t-att-style="'width:9px; height:9px; border-radius:50%; background:' + (r.level === 'red' ? '#e53e3e' : '#ffab00')"/>
                    <div style="flex:1;">
                      <div style="font-size:13px;" t-esc="r.name"/>
                      <div style="font-size:11px; color:#999;"><t t-esc="r.detail"/> <t t-esc="r.time"/></div>
                    </div>
                  </div>
                </t>
              </div>
            </t>

            <!-- ── Cổng / API / Tồn kho (DB-*-05/06) ── -->
            <t t-if="state.active === 'gateway'">
              <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:16px;">
                <div style="font-weight:600; margin-bottom:10px;">🔌 Cổng / API / Tồn kho (<t t-esc="state.d.gateways.count"/>)</div>
                <table style="width:100%; font-size:13px; border-collapse:collapse;">
                  <thead>
                    <tr style="color:#888; text-align:left; border-bottom:1px solid #eee;">
                      <th style="padding:6px;">Cổng</th><th>Trạng thái</th><th>Tỷ lệ thành công</th><th>Số dư API</th><th>Lỗi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-foreach="state.d.gateways.rows" t-as="g" t-key="g.id">
                      <tr style="border-bottom:1px solid #f4f4f4; cursor:pointer;" t-on-click="() => this.openGateways()">
                        <td style="padding:6px;"><t t-esc="g.name"/> <span style="color:#bbb;"><t t-esc="g.code"/></span></td>
                        <td><span t-att-style="'padding:2px 8px; border-radius:4px; font-size:11px; color:#fff; background:' + gateColor(g.state)" t-esc="gateLabel(g.state)"/></td>
                        <td><t t-esc="g.success_rate"/>%</td>
                        <td t-att-style="g.balance_low ? 'color:#e53e3e; font-weight:600;' : ''"><t t-esc="money(g.api_balance)"/></td>
                        <td><t t-esc="g.error_count"/></td>
                      </tr>
                    </t>
                    <t t-if="state.d.gateways.count === 0"><tr><td colspan="5" style="padding:12px; color:#aaa;">Không có cổng</td></tr></t>
                  </tbody>
                </table>
              </div>
            </t>

            <!-- ── NCC (DB-*-03) ── -->
            <t t-if="state.active === 'ncc'">
              <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:16px;">
                <div style="font-weight:600; margin-bottom:10px;">🏭 NCC (<t t-esc="state.d.ncc.count"/>)</div>
                <table style="width:100%; font-size:13px; border-collapse:collapse;">
                  <thead><tr style="color:#888; text-align:left; border-bottom:1px solid #eee;"><th style="padding:6px;">NCC</th><th>Thành công</th><th>Lỗi</th><th>Tỷ trọng SL</th><th>Công nợ</th></tr></thead>
                  <tbody>
                    <t t-foreach="state.d.ncc.rows" t-as="n" t-key="n.id">
                      <tr style="border-bottom:1px solid #f4f4f4; cursor:pointer;" t-on-click="() => this.openPartner(n.id)">
                        <td style="padding:6px;"><t t-esc="n.name"/></td>
                        <td><t t-esc="n.success_rate"/>%</td>
                        <td><t t-esc="n.error_rate"/>%</td>
                        <td t-att-style="n.warn ? 'color:#e53e3e; font-weight:600;' : ''"><t t-esc="n.concentration"/>%</td>
                        <td><t t-esc="money(n.debt)"/></td>
                      </tr>
                    </t>
                    <t t-if="state.d.ncc.count === 0"><tr><td colspan="5" style="padding:10px; color:#aaa;">Không có NCC</td></tr></t>
                  </tbody>
                </table>
              </div>
            </t>

            <!-- ── Đại lý (DB-*-04) ── -->
            <t t-if="state.active === 'agent'">
              <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:16px;">
                <div style="font-weight:600; margin-bottom:10px;">🏪 Đại lý (<t t-esc="state.d.agents.count"/>)</div>
                <table style="width:100%; font-size:13px; border-collapse:collapse;">
                  <thead><tr style="color:#888; text-align:left; border-bottom:1px solid #eee;"><th style="padding:6px;">Đại lý</th><th>Hạng</th><th>Công nợ</th><th>Hạn mức</th><th>Sử dụng</th></tr></thead>
                  <tbody>
                    <t t-foreach="state.d.agents.rows" t-as="a" t-key="a.id">
                      <tr style="border-bottom:1px solid #f4f4f4; cursor:pointer;" t-on-click="() => this.openPartner(a.id)">
                        <td style="padding:6px;"><t t-esc="a.name"/></td>
                        <td><t t-esc="a.grade"/></td>
                        <td><t t-esc="money(a.debt)"/></td>
                        <td><t t-esc="money(a.debt_limit)"/></td>
                        <td t-att-style="a.overlimit ? 'color:#e53e3e; font-weight:600;' : ''"><t t-esc="a.usage"/>%</td>
                      </tr>
                    </t>
                    <t t-if="state.d.agents.count === 0"><tr><td colspan="5" style="padding:10px; color:#aaa;">Không có đại lý</td></tr></t>
                  </tbody>
                </table>
              </div>
            </t>

            <!-- ── Công nợ (DB-*-05/06) ── -->
            <t t-if="state.active === 'debt'">
              <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:16px;">
                <div style="font-weight:600; margin-bottom:12px;">💰 Công nợ</div>
                <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:14px;">
                  <div><div style="font-size:12px; color:#888;">Phải trả NCC</div><div style="font-size:24px; font-weight:bold;"><t t-esc="money(state.d.debt.payable)"/></div></div>
                  <div><div style="font-size:12px; color:#888;">Phải thu đại lý</div><div style="font-size:24px; font-weight:bold;"><t t-esc="money(state.d.debt.receivable)"/></div></div>
                  <div><div style="font-size:12px; color:#888;">Vượt hạn mức</div><div style="font-size:24px; font-weight:bold; color:#e53e3e;"><t t-esc="state.d.debt.overlimit_count"/></div></div>
                </div>
                <t t-if="state.d.debt.overlimit.length > 0">
                  <div style="font-size:13px; font-weight:600; margin-bottom:6px;">Danh sách vượt hạn mức</div>
                  <t t-foreach="state.d.debt.overlimit" t-as="o" t-key="o_index">
                    <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid #f4f4f4; font-size:13px;">
                      <span t-esc="o.name"/><span style="color:#e53e3e;"><t t-esc="money(o.debt)"/> / <t t-esc="money(o.limit)"/></span>
                    </div>
                  </t>
                </t>
                <div style="margin-top:12px; font-size:11px; color:#aaa;">Phân tuổi nợ (0-30/31-60/61-90/&gt;90) cần dữ liệu ngày hóa đơn — sẽ bổ sung khi có kế toán.</div>
              </div>
            </t>

            <!-- ── CSKH & Ticket (DB-*-07) ── -->
            <t t-if="state.active === 'ticket'">
              <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:16px;">
                <div style="font-weight:600; margin-bottom:12px;">🎧 CSKH &amp; Ticket (tháng này)</div>
                <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:16px;">
                  <div><div style="font-size:12px; color:#888;">Mới</div><div style="font-size:24px; font-weight:bold;" t-esc="state.d.ticket.new"/></div>
                  <div><div style="font-size:12px; color:#888;">Đang mở</div><div style="font-size:24px; font-weight:bold;" t-esc="state.d.ticket.open"/></div>
                  <div><div style="font-size:12px; color:#888;">Đã đóng</div><div style="font-size:24px; font-weight:bold;" t-esc="state.d.ticket.closed"/></div>
                </div>
                <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px;">
                  <div><div style="font-size:12px; color:#888;">SLA đúng hạn</div><div t-att-style="'font-size:22px; font-weight:bold; color:' + (state.d.ticket.sla_pct >= 95 ? '#36b37e' : '#e53e3e')"><t t-esc="state.d.ticket.sla_pct"/>%</div></div>
                  <div><div style="font-size:12px; color:#888;">FCR</div><div style="font-size:22px; font-weight:bold;"><t t-esc="state.d.ticket.fcr_pct"/>%</div></div>
                  <div><div style="font-size:12px; color:#888;">Tái phát</div><div t-att-style="'font-size:22px; font-weight:bold; color:' + (state.d.ticket.repeat_pct > 5 ? '#e53e3e' : '#36b37e')"><t t-esc="state.d.ticket.repeat_pct"/>%</div></div>
                </div>
              </div>
            </t>

            <!-- ── KPI nhóm (DB-*-08/09) ── -->
            <t t-if="state.active === 'kpi'">
              <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:16px;">
                <div style="font-weight:600; margin-bottom:12px;">📊 KPI nhóm (tháng này)</div>
                <t t-if="!state.d.kpi.available">
                  <div style="color:#aaa; font-size:13px;">Module KPI chưa cài.</div>
                </t>
                <t t-elif="state.d.kpi.total === 0">
                  <div style="color:#aaa; font-size:13px;">Chưa có KPI tháng này — vào menu KPI → "Sinh KPI tháng".</div>
                </t>
                <t t-else="">
                  <div style="display:flex; gap:16px; margin-bottom:14px;">
                    <span style="padding:4px 12px; border-radius:14px; background:#e6f7ed; color:#1e7e46; font-size:13px;">A: <t t-esc="state.d.kpi.dist.a"/></span>
                    <span style="padding:4px 12px; border-radius:14px; background:#fff7e6; color:#b7791f; font-size:13px;">B: <t t-esc="state.d.kpi.dist.b"/></span>
                    <span style="padding:4px 12px; border-radius:14px; background:#fef2f2; color:#c53030; font-size:13px;">C: <t t-esc="state.d.kpi.dist.c"/></span>
                    <span style="padding:4px 12px; border-radius:14px; background:#f0f0f0; color:#777; font-size:13px;">Chưa xếp: <t t-esc="state.d.kpi.dist.none"/></span>
                  </div>
                  <table style="width:100%; font-size:13px; border-collapse:collapse;">
                    <thead><tr style="color:#888; text-align:left; border-bottom:1px solid #eee;"><th style="padding:6px;">Nhân viên</th><th>Bộ phận</th><th>SLA</th><th>FCR</th><th>Tái phát</th><th>Xếp loại</th></tr></thead>
                    <tbody>
                      <t t-foreach="state.d.kpi.rows" t-as="k" t-key="k_index">
                        <tr style="border-bottom:1px solid #f4f4f4;">
                          <td style="padding:6px;"><t t-esc="k.user"/></td>
                          <td><t t-esc="k.dept"/></td>
                          <td><t t-esc="k.sla"/>%</td>
                          <td><t t-esc="k.fcr"/>%</td>
                          <td><t t-esc="k.repeat"/>%</td>
                          <td><b t-esc="k.grade"/></td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </t>
              </div>
            </t>

            <!-- ── Placeholder cho dashboard chưa có dữ liệu nguồn ── -->
            <t t-if="state.active === 'revenue' || state.active === 'finance' || state.active === 'total_kd'">
              <div style="background:#fff; border:1px dashed #f59e0b; border-radius:8px; padding:40px; text-align:center;">
                <div style="font-size:40px;">🚧</div>
                <div style="font-size:15px; font-weight:600; margin:8px 0;">Dashboard này chưa có dữ liệu nguồn</div>
                <div style="font-size:13px; color:#888;">
                  <t t-if="state.active === 'revenue'">Cần model Doanh thu / Sản lượng theo sản phẩm (topup, mã PIN, API).</t>
                  <t t-if="state.active === 'finance'">Cần model Tài chính thương mại (deal ngân hàng, tỷ trọng vay).</t>
                  <t t-if="state.active === 'total_kd'">Cần dữ liệu BigM / Ứng tiền Viettel.</t>
                </div>
              </div>
            </t>

          </div>
        </div>
      </t>
    </div>
  </t>
</templates>
